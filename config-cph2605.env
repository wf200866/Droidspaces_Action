# ============================================================================
# OnePlus CPH2605 (MT6833 / Dimensity 6020) — Droidspaces 内核 profile
#
# 用法：
#   1. Fork https://github.com/5kind/Droidspaces_Action
#   2. 把本文件放到 fork 仓库根目录，命名 config-cph2605.env
#   3. Actions -> Build Kernel -> Run workflow -> config 填 config-cph2605.env
#
# 所有键名已逐条对照 scripts/config.sh 的 DEFAULTS 数组核实。
# 所有值已按目标机实测核对。不要凭感觉改。
# ============================================================================

# ------------------------------------------------------------------ 内核源码 ---
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_mt6833
KERNEL_SOURCE_BRANCH=oneplus/mt6833_u_14.0.0_nord_n30_se_5g

# MTK defconfig，标准版（不是 _4gb_a32k64、不是 _debug）
KERNEL_CONFIG=k6833v1_64_k419_defconfig

# 产物名。4.19 MTK 出 Image.gz；dtb 在 boot.img 里单独一段，不并进 Image
KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64

# --------------------------------------------------------------- 编译参数 ---
# 4.x 内核必须用 GCC 当 assembler。USE_LLVM=true（LLVM_IAS=1）在 4.x 上编不过
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_LLVM=false

# 六项 KCFLAGS。全部 -Wno-xxx 形式，绝对不能用 -Wno-error=xxx
# （clang 不认未识别 warning 名，而 Makefile:539 有
#  -Werror=unknown-warning-option，会把它变成致命错误）
# 最后一项 -I 解决 scp.h 找不到
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-strict-prototypes -Wno-implicit-int -Wno-date-time -Wno-incompatible-pointer-types -Wno-void-pointer-to-int-cast -Wno-pointer-to-int-cast -Wno-unused-but-set-variable -Wno-unused-variable -Wno-unused-function -Wno-unused-const-variable -Wno-sign-compare -Wno-missing-field-initializers -Wno-address-of-packed-member -Wno-error -I$(pwd)/drivers/misc/mediatek/scp/include

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# 原厂用 clang 11.0.1 (r383902)。这里取 2022 年分支，对 4.19 兼容性最好
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false

# --------------------------------------------------------- Droidspaces 核心 ---
# 一个开关搞定全部：自动识别 4.19 -> 走 non-GKI/ 目录
# -> 应用全部补丁 + 打开 70+ 项容器所需 CONFIG
# 必须开：用 patches/custom.sh 接 vendor 依赖树，否则 defconfig 解析就死
ENABLE_CUSTOM_PATCHES=true

ENABLE_DROIDSPACES=true

# 仅 5.x/6.1/6.6 生效，4.19 用不到，保持默认
SYSVIPC_KABI_PATCH=001.GKI-below-6.12-fix_sysvipc_kabi_6_7_8.patch

# 绕过 VINTF 内核配置检查。改了大量 CONFIG 之后这个弹窗几乎必然出现：
# "您的设备内部出现了问题，请联系您的制造商了解详情"
# 开了它还会把实际构建的 out/.config 打包成 artifact，方便核对
ENABLE_STOCKCONFIG=true
STOCKCONFIG_FLAGS=-vts _stock
STOCKCONFIG_MAKEFILE=kernel/Makefile

# --------------------------------------------------------------- Root 方案 ---
# resukisu = ReSukiSU，专为 legacy / non-GKI 内核维护，4.19 用这个最稳
KSU_VARIANT=resukisu
KSU_REF=
# manual = 手动 hook，非 GKI 内核的可靠选择（kprobes 在部分 4.19 上不稳）
KSU_HOOK_MODE=manual

# 4.19 < 5.9，需要回填 path_umount()，否则容器卸载路径会出问题
ENABLE_PATH_UMOUNT=true

# SUSFS 与 Droidspaces 官方明确不兼容，必须关
ENABLE_SUSFS=false
ENABLE_HIDE_STUFF=false

# ------------------------------------------------- 保住 Wi-Fi/蓝牙/GPS/触控 ---
# 设备原厂 MODULE_SIG=y + MODULE_SIG_FORCE=y + MODULE_SIG_ALL=y
# 意味着只接受用本内核 certs/signing_key.pem 签名的模块。
# 重编产生全新密钥 -> 设备上那 10 个 vendor 模块会被全部拒载 ->
# Wi-Fi / 蓝牙 / GPS / FM / 触控全废。必须整个关掉签名链。
EXTRA_DEFCONFIG=CONFIG_MODULE_SIG=n CONFIG_MODULE_SIG_FORCE=n CONFIG_MODULE_SIG_ALL=n CONFIG_MODULE_SIG_HASH= CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES= CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES=

# 原厂 CONFIG_LTO=y + CONFIG_CFI_CLANG=y。CFI 会检查每个间接调用目标，
# 跟 vendor 预编译模块的 .text 布局不匹配时直接崩。LTO + CFI 也是内存大户。
# 这是为保住 vendor 模块的权衡，代价是少一层 CFI 加固。
DISABLE_LTO=true

# 双保险：OPPO/MTK 私有代码在全树范围都有各类 warning，
# 靠逐个 -Wno- 追不现实。关掉 CONFIG_CC_WERROR 让告警不致命。
DISABLE_CC_WERROR=true

# ---------------------------------------------------- 不编 dtb（无 cust.dtsi） ---
# 原厂 defconfig 要求编译 48 个 dtb overlay：
#   CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/oplus6833_20015 mediatek/oplus6833_21101 ..."
# 但每个 .dts 都 #include "oplus6833_20015/cust.dtsi"，
# 这个 cust.dtsi 是 OPPO 定制片段，开源仓里没有、也不会有。
#
# 本项目不需要 dtb：只替换 boot.img 的 kernel 段，dtb 段按字节原样复制，
# dtbo 分区也不动。屏幕/触控/充电 IC/传感器的设备树全部保持原厂。
# 清空名单即可，编译目标只剩 vmlinux -> Image.gz。

# ------------------------------------------------------------------ 打包 ---
# 只出内核镜像，boot.img 由本地 repack_boot.py 打（复用原厂 ramdisk 保 root）
BUILD_BOOT_IMG=false

CREATE_RELEASE=true

# ------------------------------------------------------------------ 其它 ---
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true